// ============================================================
// 一次性：用歷史帳務回填品牌的「分潤%」與「所屬廠商」，並修正唐太盅
//
// 成數取「最近一次開團實際用的成數」。歷史上調整過的（例如雪坊 13→15→17），
// 會把完整軌跡寫進「分潤說明」欄，之後談約時看得到漲價過程。
//
// ⚠️ 只填空白的格子，不覆蓋你已經填過的值——你手動填的一定比推算的準。
//
// 用法：先跑一次看報告（RF_DRY_RUN = true），確認後改成 false 再跑。
// ============================================================

var RF_DRY_RUN = true;   // ← 確認報告沒問題後改成 false

function 回填品牌資料_ONETIME() {
  var log = [];
  function say(s) { log.push(s); Logger.log(s); }
  say(RF_DRY_RUN ? '===== 試算模式（不會寫入）=====' : '===== 實際執行 =====');

  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('團購品牌資料庫');
  if (!sheet) throw new Error('找不到「團購品牌資料庫」分頁');
  var data = sheet.getDataRange().getValues();
  var header = data[0].map(function (h) { return String(h).trim(); });
  var iRate = header.indexOf('分潤%');
  var iNote = header.indexOf('分潤說明');
  if (iRate < 0) throw new Error('找不到「分潤%」欄，請先在品牌資料庫加上這一欄');
  if (iNote < 0) say('  ⚠ 找不到「分潤說明」欄，歷史成數軌跡會沒地方寫');

  var rowOf = {};
  for (var i = 1; i < data.length; i++) if (data[i][0]) rowOf[String(data[i][0]).trim()] = i;

  var fill = [], skipRate = [], skipNote = 0, notFound = [];
  RATE_FILL.forEach(function (f) {
    var idx = rowOf[f[0]];
    if (idx === undefined) { notFound.push(f[0] + ' ' + f[1]); return; }
    var curRate = String(data[idx][iRate] === undefined ? '' : data[idx][iRate]).trim();
    var curNote = iNote >= 0 ? String(data[idx][iNote] || '').trim() : '';
    var job = { row: idx + 1, id: f[0], name: f[1], pct: f[2], note: f[4] };
    if (curRate) {
      // 已經有值就不動，但如果跟推算的不一樣要講出來，你才知道有落差
      skipRate.push(f[0] + ' ' + f[1] + '：現有 ' + curRate + '％、帳務推算 ' + f[2] + '％' +
                    (String(curRate) === String(f[2]) ? '（相同）' : '　← 不一樣'));
      job.pct = null;
    }
    if (!f[4] || curNote || iNote < 0) { job.note = null; if (f[4] && curNote) skipNote++; }
    if (job.pct === null && job.note === null) return;
    fill.push(job);
  });

  var nRate = fill.filter(function (j) { return j.pct !== null; }).length;
  var nNote = fill.filter(function (j) { return j.note !== null; }).length;
  say('');
  say('  可回填分潤%：' + nRate + ' 個品牌');
  say('  可寫入歷史成數軌跡：' + nNote + ' 個品牌');
  say('  已有分潤%、不覆蓋：' + skipRate.length + ' 個');
  if (skipNote) say('  已有分潤說明、不覆蓋：' + skipNote + ' 個');
  if (notFound.length) say('  ⚠ 品牌資料庫找不到這些 ID：' + notFound.slice(0, 10).join('、'));
  if (skipRate.length) {
    say('');
    say('  ── 已有值的品牌，跟帳務推算的比對（只是提醒，不會動它）：');
    skipRate.slice(0, 15).forEach(function (s) { say('      ' + s); });
    if (skipRate.length > 15) say('      …其餘 ' + (skipRate.length - 15) + ' 個');
  }
  say('');
  say('  ── 前 12 個要填的：');
  fill.slice(0, 12).forEach(function (j) {
    say('      ' + j.id + ' ' + j.name + (j.pct !== null ? '　分潤% → ' + j.pct : '') +
        (j.note ? '　說明 → ' + j.note : ''));
  });

  // ---- B. 所屬廠商回填 ----
  var iVendor = header.indexOf('所屬廠商ID');
  var vFill = [], vSkip = 0, vNotFound = 0;
  if (iVendor < 0) {
    say('');
    say('  ⚠ 找不到「所屬廠商ID」欄，跳過廠商回填');
  } else {
    BRAND_VENDOR_FILL.forEach(function (f) {
      var idx = rowOf[f[0]];
      if (idx === undefined) { vNotFound++; return; }
      if (String(data[idx][iVendor] || '').trim()) { vSkip++; return; }   // 已有值不覆蓋
      vFill.push({ row: idx + 1, id: f[0], name: f[1], vid: f[2] });
    });
    say('');
    say('  可回填所屬廠商：' + vFill.length + ' 個品牌');
    say('  已有所屬廠商、不覆蓋：' + vSkip + ' 個' + (vNotFound ? '　找不到品牌：' + vNotFound + ' 個' : ''));
  }

  // ---- C. 唐太盅／不老松 ----
  say('');
  say('【唐太盅】使用者確認「不老松」與唐太盅同一家，廠商名稱應為唐太盅');
  var vSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('團購廠商資料庫');
  var vData = vSheet.getDataRange().getValues();
  var vHeader = vData[0].map(function (h) { return String(h).trim(); });
  var viCompany = vHeader.indexOf('公司名稱');
  var tangRow = -1, tangOld = '', tangAlias = '';
  for (var t = 1; t < vData.length; t++) {
    if (String(vData[t][0]).trim() !== TANG.vendorId) continue;
    tangRow = t + 1; tangOld = String(vData[t][1] || '').trim();
    tangAlias = viCompany >= 0 ? String(vData[t][viCompany] || '').trim() : '';
  }
  if (tangRow < 0) say('  ⚠ 找不到 ' + TANG.vendorId + '，跳過');
  else {
    say('  ' + TANG.vendorId + '：名稱「' + tangOld + '」→「' + TANG.newName + '」');
    say('        公司名稱：「' + tangAlias + '」→「' +
        (tangAlias.indexOf(TANG.alias) >= 0 ? tangAlias : (tangAlias ? tangAlias + ',' + TANG.alias : TANG.alias)) + '」');
    say('  帳務裡開票公司是「' + TANG.alias + '」的紀錄，廠商ID 會補成 ' + TANG.vendorId);
  }

  if (RF_DRY_RUN) { say(''); say('===== 試算結束，確認後把 RF_DRY_RUN 改成 false 再跑 ====='); return log.join('\n'); }

  // 整欄一次寫回，逐格寫 210 次會很慢
  var rateCol = sheet.getRange(2, iRate + 1, data.length - 1, 1);
  var rateVals = rateCol.getValues();
  var noteCol = iNote >= 0 ? sheet.getRange(2, iNote + 1, data.length - 1, 1) : null;
  var noteVals = noteCol ? noteCol.getValues() : null;
  fill.forEach(function (j) {
    if (j.pct !== null) rateVals[j.row - 2][0] = j.pct;
    if (j.note !== null && noteVals) noteVals[j.row - 2][0] = j.note;
  });
  rateCol.setValues(rateVals);
  if (noteCol) noteCol.setValues(noteVals);
  say('');
  say('  ✅ 已回填分潤% ' + nRate + ' 個、寫入軌跡 ' + nNote + ' 個');

  if (iVendor >= 0 && vFill.length) {
    var vCol = sheet.getRange(2, iVendor + 1, data.length - 1, 1);
    var vVals = vCol.getValues();
    vFill.forEach(function (f) { vVals[f.row - 2][0] = f.vid; });
    vCol.setValues(vVals);
    say('  ✅ 已回填所屬廠商 ' + vFill.length + ' 個');
  }

  if (tangRow > 0) {
    // 先寫別名再改名（中斷的話舊名才不會遺失）
    if (viCompany >= 0 && tangAlias.indexOf(TANG.alias) < 0) {
      vSheet.getRange(tangRow, viCompany + 1).setValue(tangAlias ? tangAlias + ',' + TANG.alias : TANG.alias);
    }
    vSheet.getRange(tangRow, 2).setValue(TANG.newName);
    vSheet.getRange(tangRow, 9).setValue(new Date());
    // 帳務裡開票公司寫「不老松」的那筆，補上廠商ID
    var aSheet = SpreadsheetApp.openById(ACCOUNTING_SHEET_ID).getSheetByName(ACCOUNTING_SHEET_NAME);
    var aData = aSheet.getDataRange().getValues();
    var aH = aData[0].map(function (h) { return String(h).trim(); });
    var cV = aH.indexOf('廠商ID'), cC = aH.indexOf('開票公司');
    var done = 0;
    if (cV >= 0 && cC >= 0) {
      for (var q = 1; q < aData.length; q++) {
        if (String(aData[q][cC] || '').trim() !== TANG.alias) continue;
        if (String(aData[q][cV] || '').trim()) continue;
        aSheet.getRange(q + 1, cV + 1).setValue(TANG.vendorId);
        done++;
      }
    }
    say('  ✅ ' + TANG.vendorId + ' 已改名為「' + TANG.newName + '」，帳務補了 ' + done + ' 筆');
  }

  say('===== 完成 =====');
  return log.join('\n');
}
